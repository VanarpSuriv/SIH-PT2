# =============================================================================
# VERITAS Platform - Environment Configuration Template
# =============================================================================

# Server-Side Officer Authentication Token
# Required for /api/findings/{id}/review, /confirm, and /dismiss endpoints.
# The server FAILS CLOSED with HTTP 500 if this variable is unconfigured, empty, or revoked.
# Generate a new unpredictable secret (e.g. `python -c "import secrets; print(secrets.token_hex(32))"`)
OFFICER_AUTH_TOKEN=

# Audit Tamper Guard
# Controls access to /api/audit/tamper.
# Strictly disabled (false) by default. Must be explicitly set to 'true' in demonstration mode.
ENABLE_DEMO_TAMPER=false

# Frontend Client Authentication (DEMO / DEVELOPMENT ONLY)
# SECURITY NOTICE: NEXT_PUBLIC_* variables are embedded directly into client-side JavaScript
# and exposed to browser inspection. NEVER place production secrets in NEXT_PUBLIC_* variables.
# For production deployments, officer authentication must use HttpOnly session cookies or an
# enterprise identity provider (SSO / OAuth2 PKCE). This variable is strictly for local hackathon demos.
NEXT_PUBLIC_OFFICER_TOKEN=
